{
  "name": "remotish-browser-rpc-provider",
  "displayName": "Remotish Browser RPC Provider",
  "description": "SCM-agnostic browser RPC provider for Remotish.",
  "version": "0.1.0-beta.13",
  "publisher": "hrashton",
  "license": "0BSD",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HRAshton/remotish.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onCommand:remotish.browserRpc.configureBridge",
    "onFileSystem:remotish-rpc"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Browser RPC can connect to authenticated remote endpoints selected by a repository request."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "remotish.browserRpc.configureBridge",
        "title": "Remotish Browser RPC: Configure Bridge Pairing Key"
      }
    ]
  },
  "remotish": {
    "provider": true,
    "apiVersion": 1,
    "id": "browser-rpc",
    "displayName": "Browser RPC"
  },
  "dependencies": {
    "@remotish/adapter-rpc": "workspace:*",
    "@remotish/adapter-sdk": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false"
  }
}
