{
  "name": "remotish-github-provider",
  "displayName": "Remotish GitHub Provider",
  "description": "Anonymous read-only GitHub.com public repository provider for Remotish.",
  "version": "1.0.0-rc.1",
  "publisher": "hrashton",
  "license": "0BSD",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HRAshton/remotish.git"
  },
  "homepage": "https://github.com/HRAshton/remotish/tree/master/extensions/github-provider#readme",
  "bugs": {
    "url": "https://github.com/HRAshton/remotish/issues"
  },
  "engines": {
    "vscode": "^1.139.1"
  },
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:remotish-github"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "remotish": {
    "provider": true,
    "apiVersion": 1,
    "id": "github",
    "displayName": "GitHub"
  },
  "dependencies": {
    "@remotish/adapter-github": "workspace:*",
    "@remotish/adapter-sdk": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "github",
    "remote repositories",
    "virtual filesystem",
    "source control",
    "open vsx"
  ]
}
